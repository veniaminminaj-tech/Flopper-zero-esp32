<Window x:Class="FlopperZero.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flopper Zero" Height="650" Width="1000" MinHeight="560" MinWidth="820" Background="#070C14" Foreground="White" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="F L O P P E R   Z E R O" Foreground="#00E1BE" FontSize="27" FontWeight="Bold"/>
      <TextBlock Text="CONTROL CENTER  /  WINDOWS" Foreground="#8796A8" Margin="0,7,0,22" FontSize="12"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#101926" CornerRadius="12" Padding="20" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="DEVICE STATUS" Foreground="#00E1BE" FontSize="12" FontWeight="Bold"/><TextBlock Text="NOT CONNECTED" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="ESP32 • USB serial device" Foreground="#8796A8" Margin="0,4,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="CONNECT DEVICE" Padding="22,12" Background="#00E1BE" Foreground="#071018" BorderThickness="0" FontWeight="Bold" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <UniformGrid Columns="2" Rows="2" Margin="0,0,16,0">
        <Border Background="#101926" CornerRadius="10" Margin="0,0,10,10" Padding="16"><StackPanel><TextBlock Text="CONNECTION" Foreground="#00E1BE"/><TextBlock Text="USB / Serial" FontSize="17" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Background="#101926" CornerRadius="10" Margin="0,0,0,10" Padding="16"><StackPanel><TextBlock Text="DEVICE INFO" Foreground="#00E1BE"/><TextBlock Text="ESP32" FontSize="17" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Background="#101926" CornerRadius="10" Margin="0,0,10,0" Padding="16"><StackPanel><TextBlock Text="SERIAL MONITOR" Foreground="#00E1BE"/><TextBlock Text="115200 baud" FontSize="17" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Background="#101926" CornerRadius="10" Margin="0,0,0,0" Padding="16"><StackPanel><TextBlock Text="ABOUT" Foreground="#00E1BE"/><TextBlock Text="Flopper Zero" FontSize="17" Margin="0,12,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Grid.Column="1" Background="#101926" CornerRadius="10" Padding="18">
        <StackPanel><TextBlock Text="SERIAL CONSOLE" Foreground="#00E1BE" FontWeight="Bold"/><TextBlock Text="Waiting for device…" Foreground="#8796A8" Margin="0,16,0,0" FontFamily="Consolas"/></StackPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="UI PREVIEW • Firmware functions and source files are unchanged" Foreground="#718096" FontSize="11" Margin="0,16,0,0"/>
  </Grid>
</Window>
